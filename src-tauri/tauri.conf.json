{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compás Tools",
  "version": "0.1.2",
  "identifier": "com.compas.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compás Tools",
        "width": 1100,
        "height": 740,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "dmg", "nsis", "msi"],
    "category": "Utility",
    "externalBin": ["binaries/compas-sdtool"],
    "resources": {
      "../LICENSE": "licenses/LICENSE-GPL-3.0.txt",
      "../THIRD_PARTY.md": "licenses/THIRD_PARTY.md",
      "../src/assets/fonts/OFL.txt": "licenses/NotoSans-OFL.txt",
      "../src/assets/icons/COPYING-ICONS": "licenses/Breeze-icons-COPYING.txt",
      "licenses-sdtool/*": "licenses/sdtool/",
      "licenses-generated/*": "licenses/"
    },
    "shortDescription": "Manage a Compás player: install, updates, music library and plugins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDM0ZCNTVCNEMwNzdBMTAKUldRUWVnZE1XN1UvYkVUNHhUd2d1cE9UcjB2QWlqUzgwV2poYUN5emtiZVYxTHpnblkvSXo1YUwK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Starnished66/compas-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
