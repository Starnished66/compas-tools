{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compás Tools",
  "version": "0.1.0",
  "identifier": "com.compas.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compás Tools",
        "width": 1100,
        "height": 740,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "dmg", "nsis", "msi"],
    "category": "Utility",
    "externalBin": ["binaries/compas-sdtool"],
    "shortDescription": "Manage the SD card of a Compás player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
